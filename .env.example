# Optional local development configuration; defaults also work without this file.
SERVER_ADDR=127.0.0.1:3000
OBJECT_STORE_DIR=.local/object-storage
RUST_LOG=script_registry_server=info,tower_http=debug
POSTGRES_PORT=5432
POSTGRES_DB=script_registry
POSTGRES_USER=registry
POSTGRES_PASSWORD=registry-local-password
# Reserved for the later database integration; the API does not connect yet.
DATABASE_URL=postgres://registry:registry-local-password@127.0.0.1:5432/script_registry
